# Mock API (default) — runs against packages/mock-api fixtures.
PUBLIC_API_BASE=http://localhost:4455

# Live aljazeera.com endpoint (uncomment for `bun run demo:astro`).
# Astro Deno SSR derives --allow-net from this value at boot via
# scripts/demo-launch-astro.ts; live host = 443/SSL. CORS is a non-issue
# because all GraphQL fetches run server-side (no browser cross-origin).
# PUBLIC_API_BASE=https://www.aljazeera.com
