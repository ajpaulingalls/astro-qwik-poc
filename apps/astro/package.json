{
  "name": "aje-poc-astro",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && sed -i.bak '/@deno\\/astro-adapter\\/__deno_imports/d' dist/server/entry.mjs && rm dist/server/entry.mjs.bak",
    "preview": "astro preview",
    "astro": "astro",
    "perf:astro": "node --experimental-strip-types --no-warnings ../../packages/perf-harness/runner.ts --target=astro",
    "test": "bun run build && vitest run"
  },
  "dependencies": {
    "@aje-poc/shared-types": "workspace:*",
    "@astrojs/preact": "^5.0.0",
    "@deno/astro-adapter": "^0.4.0",
    "astro": "^6.1.8",
    "preact": "^10.24.0",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@aje-poc/perf-harness": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/preact": "^3.2.4",
    "chrome-launcher": "^1.1.2",
    "happy-dom": "^15.11.0",
    "puppeteer-core": "^23.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.0"
  }
}
