---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { NavigationMenu } from '../components/NavigationMenu';
import { BreakingTicker } from '../components/BreakingTicker';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  /**
   * Pre-resolved URL of the page's LCP image. When supplied, emits
   * `<link rel="preload" as="image">` so the browser starts the fetch
   * before parsing reaches the <img>. fetchpriority=high alone reorders
   * the request after parser discovery; preload starts it immediately.
   */
  preloadImage?: string;
}

const { title, preloadImage } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <Font cssVariable="--font-inter" preload />
    {/* No `preload` — would compete with the LCP image preload above. */}
    <Font cssVariable="--font-serif-display" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <script>
      // Hoisted by Astro into a deferred module chunk in <head>; runs
      // after HTML parse so doesn't block LCP. Perf-critical: M2/M9 gate
      // depends on globalThis.__webVitals being populated.
      import '../lib/web-vitals.ts';
    </script>
  </head>
  <body class="font-sans">
    <NavigationMenu client:idle />
    <BreakingTicker client:idle />
    <slot />
    <Footer />
  </body>
</html>
