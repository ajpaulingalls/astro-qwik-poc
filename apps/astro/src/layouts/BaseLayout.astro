---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { NavigationMenu } from '../components/NavigationMenu';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  /**
   * LCP image URL — emitted as <link rel="preload" as="image"> to give
   * the browser a head start in production. NOTE: in the current PoC,
   * fixture image URLs (/wp-content/uploads/*) 404 against the dev
   * server, so this preload is a no-op locally. Story-011 re-measures
   * once image serving lands.
   */
  preloadImage?: string;
}

const { title, preloadImage } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <Font cssVariable="--font-inter" preload />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <script>
      // Hoisted by Astro into a deferred module chunk in <head>; runs
      // after HTML parse so doesn't block LCP. Perf-critical: M2/M9 gate
      // depends on globalThis.__webVitals being populated.
      import '../lib/web-vitals.ts';
    </script>
  </head>
  <body class="font-sans">
    <NavigationMenu client:idle />
    <slot />
    <Footer />
  </body>
</html>
