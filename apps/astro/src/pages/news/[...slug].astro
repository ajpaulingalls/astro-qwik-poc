---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { graphqlFetch } from '../../lib/graphql';
import { ArticleHeader } from '../../components/ArticleHeader';
import { ArticleBody } from '../../components/ArticleBody';
import { RelatedStories } from '../../components/RelatedStories';
import type { Article, CuratedCollectionItem } from '@aje-poc/shared-types';

interface ArticlePageData {
  article: Article | null;
}

interface CuratedFeedData {
  homepage: { curatedCollection: CuratedCollectionItem[] };
}

// [...slug].astro requires at least one path segment; Astro's typing still
// allows undefined, so coalesce. Empty slug flows into the 404 branch below.
const rawSlug = Astro.params.slug ?? '';
const slugLeaf = rawSlug.split('/').pop() ?? '';

// Mock-api returns HTTP 404 (not a null `article`) when no fixture matches —
// translate that into a real 404 instead of a 500. Other errors propagate.
let articleData: ArticlePageData;
let curatedData: CuratedFeedData;
try {
  [articleData, curatedData] = await Promise.all([
    graphqlFetch<ArticlePageData>({
      operationName: 'ArchipelagoSingleArticleQuery',
      variables: { name: slugLeaf },
    }),
    graphqlFetch<CuratedFeedData>({
      operationName: 'HomePageCuratedFeedQuery',
      variables: { offset: 0 },
    }),
  ]);
} catch (err) {
  if (err instanceof Error && err.message.includes('404')) {
    return new Response(`Article not found: ${slugLeaf}`, { status: 404 });
  }
  throw err;
}

const article = articleData.article;
if (!article) {
  return new Response(`Article not found: ${slugLeaf}`, { status: 404 });
}

const MAX_RELATED = 6;
const collections = curatedData.homepage.curatedCollection ?? [];
const relatedPosts = collections.flatMap((c) => c.posts).slice(0, MAX_RELATED);
---

<BaseLayout title={article.title}>
  <main class="mx-auto max-w-3xl px-4 py-6">
    <ArticleHeader article={article} />
    <ArticleBody content={article.content} />
    <RelatedStories posts={relatedPosts} />
  </main>
</BaseLayout>
