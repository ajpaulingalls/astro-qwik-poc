---
import { LIVEBLOG_DEGRADED_BANNER_TEXT, type LiveBlogHeaderData } from '@aje-poc/shared-types';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LiveBlogHeader } from '../../../components/LiveBlogHeader';
import { LiveBlogEntry } from '../../../components/LiveBlogEntry';
import { LiveBlogUpdater } from '../../../components/LiveBlogUpdater';
import { loadLiveBlogData } from '../../../lib/load-liveblog';

const rawSlug = Astro.params.slug ?? '';
const slugLeaf = rawSlug.split('/').pop() ?? '';

const result = await loadLiveBlogData(slugLeaf);
if ('notFound' in result) {
  return new Response(`Live blog not found: ${slugLeaf}`, { status: 404 });
}
const { shell, entries, degraded } = result;
if (degraded) {
  // SSR-side log so a transient upstream failure surfaces in deploy logs
  // alongside the client-visible banner below.
  console.error('liveblog-route: SSR degraded:', {
    slug: slugLeaf,
    failedUpdateIds: degraded.failedUpdateIds,
  });
}

// Header receives a projected slice of the shell. Astro doesn't need to trim
// for serialization (Qwik does — see the routeLoader in
// apps/qwik/src/routes/news/liveblog/[...slug]/index.tsx), but mirroring the
// shape keeps the cross-app component contract identical.
const header: LiveBlogHeaderData = {
  title: shell.title,
  subheading: shell.subheading,
  excerpt: shell.excerpt,
  isLive: shell.isLive,
  date: shell.date,
  featuredImage: shell.featuredImage,
};
---

<BaseLayout title={shell.title}>
  <main class="mx-auto max-w-3xl px-4 py-6">
    {
      degraded && (
        <aside
          data-live-blog-degraded
          role="status"
          class="mb-4 rounded border border-yellow-300 bg-yellow-50 px-4 py-2 text-sm text-yellow-900"
        >
          {LIVEBLOG_DEGRADED_BANNER_TEXT}
        </aside>
      )
    }
    <LiveBlogHeader header={header} />
    <LiveBlogUpdater client:idle slug={slugLeaf} initialChildIds={shell.children} />
    <section class="live-blog-entries">
      {entries.map((entry) => <LiveBlogEntry entry={entry} />)}
    </section>
  </main>
</BaseLayout>
