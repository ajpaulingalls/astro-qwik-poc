# Mock API (default) — runs against packages/mock-api fixtures.
PUBLIC_API_BASE=http://localhost:4455

# Live aljazeera.com endpoint (uncomment for `bun run demo:qwik`).
# Qwik's bun server.ts reads this at boot; live host = 443/SSL. CORS is
# a non-issue because all GraphQL fetches run server-side (no browser
# cross-origin).
# PUBLIC_API_BASE=https://www.aljazeera.com
