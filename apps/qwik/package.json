{
  "name": "aje-poc-qwik",
  "private": true,
  "version": "0.0.0",
  "description": "Al Jazeera English PoC — Qwik 2 (beta) implementation",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --mode ssr",
    "build": "bun --bun vite build && bun --bun vite build --ssr ./src/entry.ssr.tsx && bun --bun vite build --ssr ./src/entry.preview.tsx",
    "preview": "bun --bun vite preview",
    "preview:prod": "bun run server.ts",
    "perf:qwik": "PUBLIC_API_BASE=http://localhost:4456 bun run ../../packages/perf-harness/runner.ts --target=qwik",
    "test": "bun run build && vitest run",
    "test:acceptance": "PUBLIC_API_BASE=http://localhost:4456 bun run build && vitest run tests/acceptance.test.ts"
  },
  "dependencies": {
    "@aje-poc/shared-csp": "workspace:*",
    "@aje-poc/shared-types": "workspace:*",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@aje-poc/perf-harness": "workspace:*",
    "@aje-poc/shared-test-helpers": "workspace:*",
    "@qwik.dev/core": "~2.0.0-beta.32",
    "@qwik.dev/router": "latest",
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "chrome-launcher": "^1.1.2",
    "puppeteer-core": "^23.0.0",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "^7.3.2",
    "vitest": "latest"
  }
}
