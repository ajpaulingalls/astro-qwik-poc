{
  "name": "aje-poc-qwik",
  "private": true,
  "version": "0.0.0",
  "description": "Al Jazeera English PoC — Qwik 2 (beta) implementation",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "vite --mode ssr",
    "build": "vite build && vite build --ssr ./src/entry.ssr.tsx && vite build --ssr ./src/entry.preview.tsx",
    "preview": "vite preview",
    "preview:prod": "node --experimental-strip-types --no-warnings server.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@aje-poc/perf-harness": "workspace:*",
    "@qwik.dev/core": "~2.0.0-beta.32",
    "@qwik.dev/router": "latest",
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "chrome-launcher": "^1.1.2",
    "puppeteer-core": "^23.0.0",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "^7.3.2",
    "vitest": "latest"
  }
}
