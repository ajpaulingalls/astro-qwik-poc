{
  "name": "aje-poc",
  "private": true,
  "version": "0.0.0",
  "description": "Al Jazeera English frontend rebuild PoC — Astro 6 vs Qwik 2, with shared mock API and performance harness",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/astro",
    "apps/qwik",
    "packages/perf-harness",
    "packages/shared-csp",
    "packages/shared-styles",
    "packages/shared-test-helpers",
    "packages/shared-types"
  ],
  "scripts": {
    "mock-api": "cd packages/mock-api && deno task dev",
    "dev:astro": "bun --filter aje-poc-astro dev",
    "dev:qwik": "bun --filter aje-poc-qwik dev",
    "build:astro": "bun --filter aje-poc-astro build",
    "build:qwik": "bun --filter aje-poc-qwik build",
    "perf": "bun --filter @aje-poc/perf-harness run",
    "perf:astro": "bun run build:astro && bun --filter @aje-poc/perf-harness run -- --target=astro",
    "perf:qwik": "PUBLIC_API_BASE=http://localhost:4456 bun run build:qwik && bun --filter @aje-poc/perf-harness run -- --target=qwik",
    "demo:astro": "bun run build:astro && bun run scripts/demo-launch-astro.ts",
    "demo:qwik": "bun run build:qwik && bun --bun apps/qwik/server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "bun --filter './apps/*' --filter './packages/*' typecheck",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@aje-poc/perf-harness": "workspace:*",
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-qwik": "2.0.0-beta.32",
    "globals": "^15.0.0",
    "lefthook": "^2.1.6",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript-eslint": "^8.59.0"
  }
}
