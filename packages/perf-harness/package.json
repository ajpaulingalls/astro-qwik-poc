{
  "name": "@aje-poc/perf-harness",
  "private": true,
  "version": "0.0.0",
  "description": "Shared Lighthouse performance harness for the AJE Astro and Qwik PoCs",
  "type": "module",
  "exports": {
    "./acceptance": "./acceptance.ts",
    "./spawn": "./spawn.ts"
  },
  "scripts": {
    "run": "bun run runner.ts",
    "bench:throughput": "bun run throughput.ts",
    "test": "vitest run",
    "test:acceptance": "bun run --cwd ../../apps/astro test:acceptance && bun run --cwd ../../apps/qwik test:acceptance",
    "test:smoke": "PERF_SMOKE=1 vitest run tests/web_vitals_collector_smoke_test.ts",
    "test:e2e-csp": "PERF_E2E=1 vitest run tests/runner_e2e_test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chrome-launcher": "^1.1.2",
    "lighthouse": "^12.2.0",
    "puppeteer-core": "^23.0.0"
  },
  "devDependencies": {
    "@aje-poc/shared-csp": "workspace:*",
    "@aje-poc/shared-test-helpers": "workspace:*",
    "@aje-poc/shared-types": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.0",
    "web-vitals": "^4.2.4"
  }
}
